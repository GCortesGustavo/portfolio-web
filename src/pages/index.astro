---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import SectionContainer from "../components/SectionContainer.astro";
import TitleSection from "../components/TitleSection.astro";
import Tecnologias from "../components/Tecnologias.astro";
import Proyectos from "../components/Proyectos.astro";
import Contacto from "../components/Contacto.astro";
import Experiencia from "../components/Experiencia.astro";
---

<Layout
  title="Gustavo Adolfo Cortés | Full Stack Developer"
  description="Desarrollador Full Stack orientado a Frontend y Mobile. Especialista en React, Next.js y TypeScript."
>
  <main class="space-y-24 py-20">
    <SectionContainer id="inicio">
      <Hero />
    </SectionContainer>

    <SectionContainer id="sobre-mi">
      <TitleSection>Sobre mí</TitleSection>
      <About />
    </SectionContainer>

    <SectionContainer id="tecnologias">
      <TitleSection>Tecnologías</TitleSection>
      <Tecnologias />
    </SectionContainer>

    <SectionContainer id="proyectos">
      <TitleSection>Proyectos</TitleSection>
      <Proyectos />
    </SectionContainer>

    <SectionContainer id="experiencia">
      <TitleSection>Experiencia Profesional</TitleSection>
      <Experiencia />
    </SectionContainer>

    <SectionContainer id="contacto">
      <TitleSection>Contacto</TitleSection>
      <Contacto />
    </SectionContainer>
  </main>
</Layout>
