---
const currentYear = new Date().getFullYear();
import Gmail from "../icons/Gmail.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import GitHub from "../icons/GitHub.astro";
---

<footer class="mt-20 py-10 px-6 border-t border-slate-200 dark:border-white/5">
  <div
    class="max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8"
  >
    <div class="text-center md:text-left space-y-2">
      <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">
        © {currentYear}
        <span class="text-amber-600 dark:text-yellow-200"
          >Gustavo Adolfo Cortés</span
        >
      </p>
      <p class="text-xs text-slate-500 dark:text-gray-400">
        Hecho con Astro, Tailwind CSS y mucho mate. 🧉
      </p>
    </div>

    <!-- Redes Sociales: Estilo consistente -->
    <div class="flex gap-x-6">
      <a
        href="https://linkedin.com/in/cortes-gustavo/"
        target="_blank"
        class="text-slate-400 hover:text-blue-500 transition-colors"
      >
        <LinkedIn class="size-6" />
      </a>
      <a
        href="https://github.com/GCortesGustavo"
        target="_blank"
        class="text-slate-400 hover:text-white dark:hover:text-white transition-colors"
      >
        <GitHub class="size-6" />
      </a>
      <a
        href="mailto:gustavocortes934@gmail.com"
        class="text-slate-400 hover:text-red-500 transition-colors"
      >
        <Gmail class="size-6" />
      </a>
    </div>

    <nav
      class="flex gap-x-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-gray-400"
    >
      <a
        href="#sobre-mi"
        class="hover:text-amber-600 dark:hover:text-yellow-200">Sobre mí</a
      >
      <a
        href="#contacto"
        class="hover:text-amber-600 dark:hover:text-yellow-200">Contacto</a
      >
    </nav>
  </div>
</footer>
