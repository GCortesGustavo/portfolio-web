---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12 px-4 max-w-6xl mx-auto">
    {PROYECTOS.map(({ title, description, github, image, link, tags, tasks }) => (
<article class="group relative bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-2xl overflow-hidden flex flex-col hover:border-amber-500/50 dark:hover:border-white/20 transition-all duration-300 shadow-xl dark:shadow-2xl">            
            <!-- Imagen con Overlay de Tareas al hacer Hover -->
            <div class="relative overflow-hidden aspect-video">
                <img
                    src={image}
                    alt={`Proyecto ${title}`}
                    class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-center p-6">
                    <p class="text-yellow-200 font-bold text-xs uppercase mb-3 tracking-widest">Lo que hice:</p>
                    <ul class="space-y-2">
                        {tasks?.slice(0, 3).map(task => (
                            <li class="text-xs text-gray-300 flex gap-2">
                                <span class="text-yellow-200">▹</span> {task}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>

            <!-- Contenido inferior -->
            <div class="p-6 flex flex-col flex-grow">
                <div class="flex justify-between items-start mb-2">
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">{title}</h3>
                    <div class="flex gap-3">
                        {github && (
                            <a href={github} target="_blank" class="text-slate-500 dark:text-gray-400 hover:text-amber-600 dark:hover:text-white transition-colors" title="Ver código">
                                <GitHubInProjects class="size-5" />
                            </a>
                        )}
                        {link && (
                            <a href={link} target="_blank" class="text-slate-500 dark:text-gray-400 hover:text-amber-600 dark:hover:text-white transition-colors" title="Ver demo">
                                <Code class="size-5" />
                            </a>
                        )}
                    </div>
                </div>

                <p class="text-sm text-slate-600 dark:text-gray-400 line-clamp-2 mb-4 flex-grow">
                    {description}
                </p>

                <!-- Tags estilo moderno -->
                <div class="flex flex-wrap gap-2 mt-auto">
                    {tags.map(tag => (
                <span class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider bg-slate-200/50 dark:bg-white/5 border border-slate-300 dark:border-white/10 text-slate-700 dark:text-gray-400 rounded-md">
                    {tag}
                </span>
                    ))}
                </div>
            </div>
        </article>
    ))}
</div>